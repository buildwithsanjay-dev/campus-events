{
  // CampusEvents is a static Vite build served by Workers Static Assets.
  // Declaring the config explicitly stops `wrangler deploy` from trying to
  // auto-detect the framework, which requires Vite 6 or newer.
  "name": "campus-events",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
